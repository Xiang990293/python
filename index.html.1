<script>
(function () {
  const body = document.body;

  /* 🚫 Do absolutely nothing in AEM edit mode */
  if (body && body.getAttribute('data-edit-mode') === 'true') {
    return;
  }

  const banner = document.getElementById('gtc26-hero-banner');
  const video = document.getElementById('video-gtc26-hero-banner'); // safest selector
  const container = document.getElementById('gtc26-hero-content');

  if (!banner || !video || !container) return;

  const REVEAL_WINDOW_SECONDS = 4;

  let revealTimeoutId = null;
  let hasRevealed = false;

  /* Enable animation only in publish mode */
  container.classList.add('nv-animate-base');

  /* ---------- Replay button injection ---------- */
  banner.classList.add('nv-has-replay');

  const btn = document.createElement('button');
  btn.type = 'button';
  btn.className = 'nv-hero-replay-btn';
  btn.setAttribute('aria-label', 'Replay video');

  // Your SVG (inline)
  btn.innerHTML = `
    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <circle cx="18" cy="18" r="18" fill="black"/>
      <path d="M28 18.7415L12 9.4082V28.0749L28 18.7415Z" fill="#76B900"/>
    </svg>
  `;

  banner.appendChild(btn);

  function showReplayButton() {
    btn.classList.add('is-visible');
  }

  function hideReplayButton() {
    btn.classList.remove('is-visible');
  }

  /* ---------- Content animation control ---------- */
  function clearRevealTimer() {
    if (revealTimeoutId !== null) {
      clearTimeout(revealTimeoutId);
      revealTimeoutId = null;
    }
  }

  function revealNow() {
    if (hasRevealed) return;
    hasRevealed = true;

    requestAnimationFrame(() => {
      container.classList.add('nv-animate-in');
    });
  }

  function scheduleReveal() {
    if (!Number.isFinite(video.duration) || video.duration <= 0) return;

    const revealAt = Math.max(0, video.duration - REVEAL_WINDOW_SECONDS);

    clearRevealTimer();

    // If already inside the reveal window, reveal immediately.
    if (video.currentTime >= revealAt) {
      revealNow();
      return;
    }

    revealTimeoutId = setTimeout(
      revealNow,
      (revealAt - video.currentTime) * 1000
    );
  }

  function resetContentInstantlyToHidden() {
    // Prevent “reverse” animation by disabling transitions temporarily
    container.classList.add('nv-no-transition');

    // Ensure we're back to hidden/base state
    container.classList.remove('nv-animate-in');
    container.classList.add('nv-animate-base');

    // Force reflow so the browser applies the hidden state immediately
    void container.offsetHeight;

    // Re-enable transitions for the next reveal animation
    container.classList.remove('nv-no-transition');
  }

  /* ---------- Video event wiring ---------- */
  video.addEventListener('play', () => {
    hideReplayButton();

    // Detect video restart (from any source: replay button, browser resize, external code)
    // If video is starting from the beginning, reset animation state
    if (video.currentTime < 0.5) {
      hasRevealed = false;
      clearRevealTimer();
      resetContentInstantlyToHidden();
    }

    scheduleReveal();
  });

  video.addEventListener('loadedmetadata', scheduleReveal);
  video.addEventListener('durationchange', scheduleReveal);

  video.addEventListener('ended', () => {
    clearRevealTimer();
    showReplayButton();
  });

  /* ---------- Replay click ---------- */
  btn.addEventListener('click', () => {
    // Reset content so it can animate again on this replay
    hasRevealed = false;
    clearRevealTimer();
    resetContentInstantlyToHidden();

    // Restart and play the video
    try {
      video.currentTime = 0;
    } catch (e) {
      // If setting currentTime fails for any reason, we still try play()
    }

    const p = video.play();
    if (p && typeof p.catch === 'function') {
      p.catch(() => {
        // Autoplay restrictions shouldn't apply since this is a user gesture,
        // but just in case, we keep the button visible.
        showReplayButton();
      });
    }
  });

  /* Autoplay safety net: if video is already playing when script runs */
  if (!video.paused && !video.ended) {
    hideReplayButton();
    scheduleReveal();
  } else if (video.ended) {
    showReplayButton();
  } else {
    // If it hasn't started yet, keep button hidden until ended
    hideReplayButton();
  }
})();
